# Corporate sponsorship checkout. Keep disabled until auction release approval.
PAYMENTS_ENABLED=false
# Individual Mission 01 support checkout. Independent from corporate sponsorship checkout.
SUPPORT_PAYMENTS_ENABLED=false

SITE_URL=https://sendmesomewhere.veridianapi.com
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only: SUPABASE_SERVICE_ROLE_KEY=

# Existing corporate Whop key. Keep its current minimal corporate permissions only.
WHOP_API_KEY=
# Dedicated individual-support Whop key. Do not reuse the corporate key.
WHOP_SUPPORT_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=

# Corporate sponsorship plans. Optional override of lib/whop-plans.json.
# WHOP_PLAN_IDS_JSON={}

# Dedicated Whop product for individual Mission 01 support.
WHOP_SUPPORT_PRODUCT_ID=
# Optional reusable one-time plan IDs for the six presets ($1/$5/$10/$25/$50/$100).
# Keys are cents. Custom amounts create a hidden one-time plan server-side.
# WHOP_SUPPORT_PLAN_IDS_JSON={"100":"plan_...","500":"plan_...","1000":"plan_...","2500":"plan_...","5000":"plan_...","10000":"plan_..."}

RATE_LIMIT_SALT=
